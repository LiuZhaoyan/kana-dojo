# Required for PPIO OpenAI-compatible translation
LLM_API_KEY=
LLM_BASE_URL=https://api.ppio.com/openai
LLM_MODEL=

# Required on Vercel for personal site protection
PERSONAL_SITE_USERNAME=kana
PERSONAL_SITE_PASSWORD=

# Disable analytics for a private personal deployment
ANALYTICS_DISABLED=true

# Optional: use only your own Sentry project
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
